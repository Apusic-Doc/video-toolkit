#!/bin/bash
VFILE="$(git rev-parse --show-toplevel)/VERSION"
VER=$(head -1 "$VFILE" 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' || echo "1.0.0")
IFS='.' read -r MAJ MIN PAT <<< "$VER"
NEW="$MAJ.$MIN.$((PAT+1))"
TS=$(date -u +"%Y-%m-%d %H:%M UTC")
echo "$NEW  ($TS)" > "$VFILE"
git add "$VFILE"
echo "📦 v$NEW"
